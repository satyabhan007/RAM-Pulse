{
  "name": "desktop-memory-widget",
  "version": "1.1.0",
  "description": "Live System Memory Telemetry and 1-Click Optimization Desktop Widget (Windows + Linux)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:linux": "electron --no-sandbox .",
    "web": "node server.js",
    "web:linux": "sudo -n true 2>/dev/null; node server.js",
    "smoke": "node scripts/smoke_test.js",
    "install-linux": "bash scripts/install_linux.sh"
  },
  "keywords": [
    "memory-widget",
    "desktop-widget",
    "ram-optimizer",
    "windows-telemetry"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "devDependencies": {
    "electron": "^34.2.0"
  },
  "dependencies": {
    "ws": "^8.17.0",
    "ps-list": "^9.0.0"
  },
  "allowScripts": {
    "electron@34.2.0": true
  }
}
