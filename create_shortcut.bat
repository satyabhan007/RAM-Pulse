@echo off
rem Create a direct GUI desktop shortcut for RAM Pulse (no command prompt / shell window)
powershell -NoProfile -Command "$desktop = [Environment]::GetFolderPath('Desktop'); $target = 'D:\DesktopMemoryWidget\node_modules\electron\dist\electron.exe'; $args = 'D:\DesktopMemoryWidget'; $icon = 'D:\DesktopMemoryWidget\assets\icon.ico'; $shortcutPath = Join-Path $desktop 'RAM Pulse Widget.lnk'; $ws = New-Object -ComObject WScript.Shell; $shortcut = $ws.CreateShortcut($shortcutPath); $shortcut.TargetPath = $target; $shortcut.Arguments = $args; $shortcut.WorkingDirectory = 'D:\DesktopMemoryWidget'; $shortcut.IconLocation = $icon + ',0'; $shortcut.Description = 'RAM Pulse - Live Desktop Memory Widget & Optimizer'; $shortcut.Save(); Write-Host 'Direct GUI shortcut created on Desktop (Zero Shell Window)';"
